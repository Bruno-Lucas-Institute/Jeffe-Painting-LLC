{
	"name": "reusable-business-template",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
		"push:worker": "node --env-file-if-exists=.env.local scripts/push-worker.mjs",
		"setup:owner": "node scripts/setup-owner.mjs",
		"client:new": "node --import tsx scripts/new-client.mjs",
		"client:check": "node --import tsx scripts/check-client.mjs",
		"qa:local": "node --env-file-if-exists=.env.local --import tsx scripts/qa-local.mjs"
	},
	"dependencies": {
		"lucide-react": "^1.69.0",
		"next": "16.4.4",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"server-only": "^0.0.1",
		"web-push": "^3.6.7",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/turbopack": "^4",
		"@types/node": "^24.19.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/web-push": "^3.6.4",
		"eslint": "^9",
		"eslint-config-next": "16.4.4",
		"prettier": "^3",
		"tailwindcss": "^4",
		"tsx": "^4.23.15",
		"typescript": "^5"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
