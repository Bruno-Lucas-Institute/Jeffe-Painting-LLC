# Select before building; this contains PUBLIC content only.
NEXT_PUBLIC_CLIENT_PROFILE=jeffe
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set a separate owner for each client. Never copy another client's private env.
OWNER_USERNAME=
OWNER_PASSWORD_HASH=
# Blank uses .local-data/<business-id>. Production requires an explicit persistent volume.
OWNER_DATA_DIR=
OWNER_DEV_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace@example.com
PUSH_RETRY_SECRET=
PUSH_RETRY_ORIGIN=
TRUST_PROXY=false
